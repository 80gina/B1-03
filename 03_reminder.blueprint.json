      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0,
        "mode": "select",
        "from": "drive",
        "spreadsheetId": "/__SPREADSHEET_ID_FROM_CONFIG__",
        "sheetId": "__SHEET_ID_TRACKER__",
