          "29": "{{now}}",
          "30": "EVT-{{formatDate(now; \"YYYYMMDDHHmmss\"; \"Asia/Seoul\")}}-{{1.`0`}}-REMIND",
          "36": "성공"
        },
        "valueInputOption": "USER_ENTERED"
