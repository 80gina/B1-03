{
  "name": "SCN-03_5일미제출_Discord리마인드",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:searchRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0,
        "mode": "select",
        "from": "drive",
        "spreadsheetId": "/__SPREADSHEET_ID_FROM_CONFIG__",
        "sheetId": "__SHEET_ID_TRACKER__",
        "includesHeaders": true,
        "tableFirstRow": "A1:AZ1",
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING"
      },
      "mapper": {
        "filter": [
          [
            {
              "a": "Z",
              "b": "완료",
              "o": "text:notequal"
            }
          ]
        ],
        "sortOrder": "asc",
        "orderBy": "AB",
        "limit": 500
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "진행중 트래커 행 검색"
        },
        "notes": "가져오기 후 레벨업트래커 탭과 Z=전체완료여부, AB=다음리마인드예정일시 열을 UI에서 재선택하세요."
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "__DISCORD_WEBHOOK_URL__?wait=true",
        "serializeUrl": false,
        "method": "post",
        "headers": [],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"username\":\"냉장고 퀘스트 상태창\",\"allowed_mentions\":{\"parse\":[]},\"embeds\":[{\"title\":\"[QUEST REMINDER] Lv.{{1.`8`}} 퀘스트가 기다리고 있어요\",\"description\":\"**현재 상태** Lv.{{1.`8`}} {{1.`9`}} · 진행중\\\\n**현재 퀘스트** {{switch(1.`8`; 1; \\\"냉장고 속 재료 3가지로 요리 1개 완성\\\"; 2; \\\"자취요리를 나만의 방식으로 업그레이드\\\"; 3; \\\"메인요리와 반찬 2개 이상으로 한 상 차리기\\\"; 4; \\\"기존 레시피를 응용한 창작 요리\\\"; 5; \\\"인생 한 끼 완성\\\"; \\\"현재 퀘스트\\\")}}\\\\n**퀘스트 이어하기** __MISSION_FORM_PREFILL_BASE_URL__\\\\n\\\\n🌿 “거창하지 않아도 괜찮다. 오늘 한 숟갈부터 다시 시작해 보자.”\",\"color\":13210430,\"fields\":[{\"name\":\"플레이어\",\"value\":\"{{1.`3`}}\",\"inline\":true},{\"name\":\"참가자ID\",\"value\":\"{{1.`0`}}\",\"inline\":true}],\"footer\":{\"text\":\"냉장고 파먹기 레벨업 챌린지 · 상태창 70% + 할머니 손맛 30%\"}}]}",
        "parseResponse": true,
        "authUser": "",
        "authPass": "",
        "timeout": "40",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "metadata": {
        "designer": {
          "x": 350,
          "y": 0,
          "name": "Discord 5일 리마인드"
        },
        "notes": "Discord Incoming Webhook JSON Embed. allowed_mentions.parse=[] 유지. Webhook URL은 배포 전 안전하게 주입하세요."
      },
      "filter": {
        "name": "5일 리마인드 조건: 진행중 + 예정일 도래 + 미발송",
        "conditions": [
