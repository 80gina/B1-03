{
  "name": "SCN-01_참가신청_Discord웰컴",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:watchRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0,
        "mode": "select",
        "from": "drive",
        "spreadsheetId": "/__SPREADSHEET_ID_FROM_CONFIG__",
        "sheetId": "__SHEET_ID_JOIN_RESPONSE__",
        "includesHeaders": true,
        "tableFirstRow": "A1:AZ1",
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING",
        "limit": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "참가신청_응답 신규 행"
        },
        "notes": "가져오기 후 Google 연결, 운영 DB, 응답 탭을 다시 선택하고 동적 열을 새로 로드하세요."
      }
    },
    {
      "id": 2,
      "module": "google-sheets:searchRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0,
        "mode": "select",
        "from": "drive",
        "spreadsheetId": "/__SPREADSHEET_ID_FROM_CONFIG__",
        "sheetId": "__SHEET_ID_TRACKER__",
        "includesHeaders": true,
        "tableFirstRow": "A1:AZ1",
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING"
      },
      "mapper": {
        "filter": [
          [
            {
              "a": "E",
              "b": "{{lower(trim(1.`3`))}}",
              "o": "text:equal"
            }
          ]
        ],
        "sortOrder": "asc",
        "orderBy": "__ROW_NUMBER__",
        "limit": 1
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "이메일로 중복 참가자 검색"
        },
        "notes": "Search Rows 모듈을 열어 열 목록을 새로 로드하고, 필터 열/연산자를 UI에서 재선택하세요. 0건일 때도 빈 번들로 계속 진행(continue/empty result)하도록 설정해야 신규/미확인 경로가 실행됩니다."
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "신규/중복 분기"
        },
        "notes": "Router 경로는 상호 배타적으로 설계했지만, 가져오기 후 각 필터를 열어 연산자와 매핑 토큰을 확인하세요."
      },
      "routes": [
        {
          "flow": [
            {
              "id": 4,
              "module": "google-sheets:addRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": 0,
                "mode": "select",
                "from": "drive",
                "spreadsheetId": "/__SPREADSHEET_ID_FROM_CONFIG__",
                "sheetId": "__SHEET_ID_TRACKER__",
                "includesHeaders": true,
                "tableFirstRow": "A1:AZ1",
                "valueRenderOption": "FORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING"
              },
              "mapper": {
                "values": {
                  "0": "FC-{{formatDate(now; \"YYYYMMDD\"; \"Asia/Seoul\")}}-{{formatNumber(1.`__ROW_NUMBER__`; \"0000\")}}",
                  "1": "{{1.`0`}}",
                  "2": "{{1.`1`}}",
                  "3": "{{1.`2`}}",
                  "4": "{{lower(trim(1.`3`))}}",
                  "5": "{{replace(1.`4`; \"/[^0-9]/g\"; emptystring)}}",
                  "6": "Discord Webhook",
                  "7": "N",
                  "8": "1",
                  "9": "초보 요리사",
                  "10": "진행중",
                  "11": "",
                  "12": "",
                  "13": "잠김",
                  "14": "",
                  "15": "",
                  "16": "잠김",
                  "17": "",
                  "18": "",
                  "19": "잠김",
                  "20": "",
                  "21": "",
                  "22": "잠김",
                  "23": "",
                  "24": "",
                  "25": "진행중",
                  "26": "",
                  "27": "",
                  "28": "N",
                  "29": "",
                  "30": "EVT-{{formatDate(now; \"YYYYMMDDHHmmss\"; \"Asia/Seoul\")}}-FC-{{formatDate(now; \"YYYYMMDD\"; \"Asia/Seoul\")}}-{{formatNumber(1.`__ROW_NUMBER__`; \"0000\")}}-JOIN",
                  "31": "미발급",
                  "32": "",
                  "33": "",
                  "34": "",
                  "35": "CERT|FC-{{formatDate(now; \"YYYYMMDD\"; \"Asia/Seoul\")}}-{{formatNumber(1.`__ROW_NUMBER__`; \"0000\")}}|V1",
                  "36": "대기",
                  "37": "건너뜀",
                  "38": ""
                },
                "valueInputOption": "USER_ENTERED",
                "insertDataOption": "INSERT_ROWS"
              },
              "metadata": {
                "designer": {
                  "x": 650,
                  "y": -120,
                  "name": "신규 트래커 행 생성"
                },
                "notes": "가져오기 후 레벨업트래커 탭을 다시 선택하고 39개 동적 열 매핑을 확인하세요."
              },
              "filter": {
                "name": "신규 신청: 이메일 검색 결과 없음",
                "conditions": [
                  [
                    {
                      "a": "{{2.`__ROW_NUMBER__`}}",
                      "o": "notexist"
                    }
                  ]
                ]
              }
            },
            {
              "id": 5,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "__DISCORD_WEBHOOK_URL__?wait=true",
                "serializeUrl": false,
                "method": "post",
                "headers": [],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "{\"username\":\"냉장고 퀘스트 상태창\",\"allowed_mentions\":{\"parse\":[]},\"embeds\":[{\"title\":\"[SYSTEM] 첫 퀘스트가 도착했습니다 — Lv.1 초보 요리사\",\"description\":\"챌린지 입장 완료!\\\\n\\\\n**[MAIN QUEST]** 냉장고 속 재료 3가지로 요리 1개 완성\\\\n**인증** 완성 사진 + 재료 목록 + 요리 이름\\\\n**진행도** 0/5\\\\n**퀘스트 링크** __MISSION_FORM_PREFILL_BASE_URL__\\\\n\\\\n🌿 “있는 재료부터 찬찬히 꺼내 보자. 한 끼는 거기서 시작된단다.”\",\"color\":12082232,\"fields\":[{\"name\":\"플레이어\",\"value\":\"{{1.`2`}}\",\"inline\":true},{\"name\":\"참가자ID\",\"value\":\"FC-{{formatDate(now; \\\"YYYYMMDD\\\"; \\\"Asia/Seoul\\\")}}-{{formatNumber(1.`__ROW_NUMBER__`; \\\"0000\\\")}}\",\"inline\":true}],\"footer\":{\"text\":\"냉장고 파먹기 레벨업 챌린지 · 상태창 70% + 할머니 손맛 30%\"}}]}",
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "40",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "followAllRedirects": false
              },
              "metadata": {
                "designer": {
                  "x": 950,
                  "y": -120,
                  "name": "Discord 웰컴 + Lv.1"
                },
                "notes": "Discord Incoming Webhook JSON Embed. allowed_mentions.parse=[] 유지. Webhook URL은 배포 전 안전하게 주입하세요."
              }
            },
            {
              "id": 6,
              "module": "google-sheets:updateRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": 0,
                "mode": "select",
                "from": "drive",
                "spreadsheetId": "/__SPREADSHEET_ID_FROM_CONFIG__",
                "sheetId": "__SHEET_ID_TRACKER__",
                "includesHeaders": true,
                "tableFirstRow": "A1:AZ1",
                "valueRenderOption": "FORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING"
              },
              "mapper": {
                "rowNumber": "{{4.`__ROW_NUMBER__`}}",
                "values": {
                  "26": "{{now}}",
                  "27": "{{addDays(now; 5)}}",
                  "36": "성공"
                },
                "valueInputOption": "USER_ENTERED"
              },
              "metadata": {
                "designer": {
                  "x": 1250,
                  "y": -120,
                  "name": "Discord 안내/리마인드 시각 갱신"
                },
                "notes": "Discord Webhook 2xx 성공 후 최근 안내 시각, 5일 리마인드 예정, Discord최근발송상태를 갱신합니다."
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 7,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "__DISCORD_WEBHOOK_URL__?wait=true",
                "serializeUrl": false,
                "method": "post",
                "headers": [],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "{\"username\":\"냉장고 퀘스트 상태창\",\"allowed_mentions\":{\"parse\":[]},\"embeds\":[{\"title\":\"[SYSTEM] 이미 참가 중인 챌린지입니다\",\"description\":\"기존 참가 기록을 찾았습니다. 중복 트래커 행은 만들지 않았습니다.\\\\n현재 상태: Lv.{{2.`8`}} {{2.`9`}}\",\"color\":13210430,\"fields\":[{\"name\":\"플레이어\",\"value\":\"{{2.`3`}}\",\"inline\":true},{\"name\":\"참가자ID\",\"value\":\"{{2.`0`}}\",\"inline\":true}],\"footer\":{\"text\":\"냉장고 파먹기 레벨업 챌린지 · 상태창 70% + 할머니 손맛 30%\"}}]}",
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "40",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "followAllRedirects": false
              },
              "metadata": {
                "designer": {
                  "x": 650,
                  "y": 180,
                  "name": "Discord 중복 신청 안내"
                },
                "notes": "Discord Incoming Webhook JSON Embed. allowed_mentions.parse=[] 유지. Webhook URL은 배포 전 안전하게 주입하세요."
              },
              "filter": {
                "name": "중복 신청: 이메일 검색 결과 있음",
                "conditions": [
                  [
                    {
                      "a": "{{2.`__ROW_NUMBER__`}}",
                      "o": "exist"
                    }
                  ]
                ]
              }
            },
            {
              "id": 8,
              "module": "google-sheets:updateRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": 0,
                "mode": "select",
                "from": "drive",
                "spreadsheetId": "/__SPREADSHEET_ID_FROM_CONFIG__",
                "sheetId": "__SHEET_ID_TRACKER__",
                "includesHeaders": true,
                "tableFirstRow": "A1:AZ1",
                "valueRenderOption": "FORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING"
              },
              "mapper": {
                "rowNumber": "{{2.`__ROW_NUMBER__`}}",
                "values": {
                  "36": "성공"
                },
                "valueInputOption": "USER_ENTERED"
              },
              "metadata": {
                "designer": {
                  "x": 950,
                  "y": 180,
                  "name": "중복 안내 Discord 상태 갱신"
                },
                "notes": "가져오기 후 레벨업트래커의 Discord최근발송상태(0-based index 36)와 행 번호를 UI에서 다시 선택하세요."
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "slots": 1,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "eu2.make.com",
    "notes": [
      "조립형 Discord Blueprint: Google Sheets 연결/탭/열과 Discord Webhook URL은 가져오기 후 재선택·안전 주입하세요.",
      "공개 채널에는 챌린지닉네임과 참가자ID만 참가자 식별 정보로 표시합니다.",
      "모든 Discord payload는 allowed_mentions.parse=[]이며 Embed 형식입니다.",
      "Search Rows 0건에서도 신규 경로가 실행되도록 empty result/continue 옵션을 켜세요."
    ],
    "assemblyBlueprint": true,
    "requiredPostImportAction": "Google Sheets 모듈을 다시 매핑하고 __DISCORD_WEBHOOK_URL__을 Make 비밀 변수 또는 안전한 모듈 입력으로 교체한 뒤 Run once 검증"
  },
  "scheduling": {
    "type": "indefinitely",
    "interval": 60,
    "enabled": false
  }
}
